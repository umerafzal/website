---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout title="About" description={`About ${siteConfig.name} — ${siteConfig.role} in ${siteConfig.location}.`} path="/about">
  <Container as="article" class="py-16 sm:py-20">
    <SectionHeading title="About" description="Personal but professional — who I am and what I'm building toward." />

    <div class="prose-portfolio max-w-2xl space-y-8">
      <section aria-labelledby="bio">
        <h2 id="bio" class="text-lg font-semibold text-[var(--fg)]">Biography</h2>
        <p>{siteConfig.bio}</p>
        <p>
          I work on mobile systems where reliability, architecture, and developer experience matter — usually on
          large consumer products, with increasing attention to AI and intelligent software.
        </p>
      </section>

      <section aria-labelledby="enjoy">
        <h2 id="enjoy" class="text-lg font-semibold text-[var(--fg)]">What I enjoy building</h2>
        <ul>
          <li>Mobile products</li>
          <li>Developer infrastructure</li>
          <li>Reliable systems</li>
          <li>AI-powered experiences</li>
        </ul>
      </section>

      <section aria-labelledby="exploring">
        <h2 id="exploring" class="text-lg font-semibold text-[var(--fg)]">Currently exploring</h2>
        <ul>
          <li>On-device AI</li>
          <li>Apple Foundation Models</li>
          <li>Mobile AI infrastructure</li>
          <li>AI agents</li>
          <li>RAG</li>
          <li>Developer tooling</li>
        </ul>
      </section>

      <section aria-labelledby="beyond">
        <h2 id="beyond" class="text-lg font-semibold text-[var(--fg)]">Beyond code</h2>
        <p class="font-mono text-sm">TODO: Add a few personal interests when ready — left intentionally blank.</p>
      </section>
    </div>

    <div class="mt-12 border-t border-[var(--border)] pt-8">
      <SocialLinks />
    </div>
  </Container>
</BaseLayout>
