---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import ConfidentialityNote from '@/components/ConfidentialityNote.astro';
import { getCollection, render } from 'astro:content';
import { projectSlug } from '@/utils/projects';
import { href } from '@/utils/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: projectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  path={`/projects/${projectSlug(project)}`}
  ogType="article"
>
  <Container as="article" class="py-16 sm:py-20">
    <ProjectHero project={project} />
    {project.data.showConfidentialityNote && <ConfidentialityNote />}
    <div class="prose-portfolio">
      <Content />
    </div>
    <p class="mt-12">
      <a href={href('/projects')} class="text-sm text-[var(--accent)] underline underline-offset-4">← All work</a>
    </p>
  </Container>
</BaseLayout>
