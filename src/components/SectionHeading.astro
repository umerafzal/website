---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class="mb-10 max-w-2xl">
  {
    eyebrow && (
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-[var(--muted)]">
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {description && <p class="mt-3 text-[var(--muted)] leading-relaxed">{description}</p>}
</div>
